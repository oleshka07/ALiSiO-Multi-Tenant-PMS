# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local database
/data/
*.db
*.db-shm
*.db-wal

# local env files
.env
.env*.local

# vercel & ide
.vercel
.idea
.vscode

# deploy environment files hold real secrets
/deploy/env.*
!/deploy/env.*.example

# OCR language data is committed; runtime caches are not
/ocr-lang/*.traineddata.gz
/ocr-lang/.probe.*

# build artefacts
tsconfig.tsbuildinfo

# Playwright artefacts
test-results/
playwright-report/
audit-ui-report.json

# i18n hand-off files — the dictionary is the artefact, not this
.i18n-work/

# database dumps hold real guest data — never in git (they already leaked into
# a docker build context once; .dockerignore closes that side, this closes git)
/deploy/backups/
# object-store credentials for off-site backups
/deploy/rclone.conf

# записи мережі чужих сервісів для дослідження: усередині cookie сесії,
# Authorization і персональні дані гостей. У репозиторій їде лише дайджест
# (scripts/har-digest.mjs), сирий запис — ніколи
*.har
/docs/research/**/capture/
