      "options": null
    },
    {
      "tag": "input",
      "type": "radio",
      "name": "radio-group-ekkevntl3",
      "label": "Separate storno invoices\nEach prior invoice is reversed by its own storno document, then a final invoice is issued for the full amount of the stay.",
      "placeholder": null,
      "required": null,
      "disabled": null,
      "testId": null,
      "options": null
