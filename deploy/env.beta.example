# Beta / staging. Copy to deploy/env.beta on the server and fill in.
#
# A different port, a different compose project and therefore a different data
# volume: beta must never read or write production's database.
ENV_NAME=beta
APP_PORT=3131
APP_URL=https://beta.pms.example.com

# Deliberately NOT the production key — a leak from staging must not decrypt
# production credentials.
APP_SECRET_KEY=

# ── Postgres ────────────────────────────────────────────────────────────────
# Left empty and unused while this environment runs on SQLite, which is the
# default. `deploy/to-postgres.sh beta` fills DB_DRIVER and DATABASE_URL in
# once the data has been moved and row-level security has been proved.
#
# DB_DRIVER is what actually chooses the engine. DATABASE_URL on its own does
# nothing — two variables on purpose, because this file used to carry a
# DATABASE_URL left by a scaffold that pointed at a server which did not exist.
DB_DRIVER=
DATABASE_URL=

# The superuser owns the tables; the application connects as PG_APP_USER, which
# owns nothing. FORCE ROW LEVEL SECURITY in the schema covers the owner too, but
# relying on that alone means one table added later without FORCE is a silent
# read across every tenant.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
PG_SUPERUSER=alisio_admin
PG_SUPERUSER_PASSWORD=
PG_APP_USER=alisio_app
PG_APP_PASSWORD=
PG_DATABASE=alisio
# Loopback only, and a different port per environment so the two never meet.
PG_PORT=54331

# ── OpenAI ──────────────────────────────────────────────────────────────────
# Guest content translation and passport OCR. Both fail quietly without it:
# translateAndStore() reports everything skipped, and OCR throws at the person
# registering a guest. Empty is a supported state — see deploy/env.prod.example.
OPENAI_API_KEY=

# ─── Channex (channel manager) ───────────────────────────────────────────────
# Застосунок ключ ЗВІДСИ НЕ ЧИТАЄ (перевірено 02.09.2026: жодного читання в
# src/). Ключ готелю вводиться в майстрі підключення (Налаштування →
# Канал-менеджер → Підключення) і лягає в `channel_credentials` під іменем
# `channel_manager`; середовище (staging/production) обирається там само.
# Ці дві змінні читають лише живі скрипти оператора `scripts/channex-*-live.mjs`
# — для деплою їх можна лишити порожніми.
CHANNEX_API_KEY=
# Для скриптів на беті — ЗАВЖДИ staging. Продакшн-ключ Channex тут означав би,
# що тестовий прогін пише в живий лістинг готелю на Booking.com.
CHANNEX_ENV=staging

# ─── Scheduled jobs ──────────────────────────────────────────────────────────
# Without these the routes that use them refuse with 503 rather than running
# for anyone who asks. That is deliberate: they used to fall back to a default
# printed in the source, and docker-compose never passed them in, so the
# fallback was the live configuration.
#   openssl rand -hex 32
CRON_SECRET=
# Its own value, so handing a channel manager a URL does not hand it the crontab.
ICAL_CRON_SECRET=

# ─── Outgoing mail ───────────────────────────────────────────────────────────
# Guest confirmations, reminders and abandoned-cart letters. Unset means no
# guest email leaves the system.
EMAIL_CZ_SMTP_HOST=
EMAIL_CZ_SMTP_PORT=587
EMAIL_CZ_USER=
EMAIL_CZ_PASSWORD=
EMAIL_FROM_NAME=

# ─── Backups off-site ────────────────────────────────────────────────────────
# Куди щодня їде дамп (deploy/backup.sh; розклад ставить сам деплой через
# deploy/setup-backup-cron.sh). BACKUP_REMOTE — rclone-шлях "ремоут:бакет"
# із deploy/rclone.conf; сховище ПОЗА Hetzner (Backblaze B2, Wasabi, S3…),
# ключ ТІЛЬКИ на запис, versioning увімкнено, ретеншн 30 днів робить САМЕ
# сховище (lifecycle) — сервер не має права стирати власну історію.
# Порожньо = дамп лише локальний, і check-backup-age.sh про це кричить.
BACKUP_REMOTE=
# Dead-man switch: URL, який пінгується ПІСЛЯ успішної заливки
# (healthchecks.io — безкоштовно). Алерт приходить, коли пінг ЗНИКАЄ,
# тому це єдиний алерт, який ловить і мертвий cron.
BACKUP_PING_URL=
# Telegram-алерт від check-backup-age.sh, коли бекап старший за 30 годин.
TG_ALERT_BOT_TOKEN=
TG_ALERT_CHAT_ID=

# ─── Ліміти памʼяті контейнерів ──────────────────────────────────────────────
# 4 ГБ хоста ділять два стеки і чужі проєкти; без стелі OOM-killer іде за
# найтовщим процесом, а це прод-Postgres (26 серпня диск, наступного разу
# памʼять). Дефолти живуть у deploy/docker-compose.yml: 900m застосунок,
# 640m Postgres. Порожньо = дефолт; підняти можна тут, окремо на середовище.
APP_MEM_LIMIT=
PG_MEM_LIMIT=
# Міст Winhotel (профіль `bridge`, лише в готелю, що переїжджає з Winhotel):
# дефолт 768m у compose. Виміряти на живому знімку — docs/DEPLOY.md «Міст Winhotel».
BRIDGE_MEM_LIMIT=

# ─── Sentry ──────────────────────────────────────────────────────────────────
# DSN проєкту (sentry.io → Settings → Projects → Client Keys). Порожньо =
# збір вимкнено. Летять серверні помилки (кожен serverError) і крахи процесу;
# environment = ENV_NAME, тож prod і beta в Sentry розділені. SDK не
# підключався навмисно — власний конверт на 40 рядків: core/monitoring/sentry.ts.
SENTRY_DSN=
