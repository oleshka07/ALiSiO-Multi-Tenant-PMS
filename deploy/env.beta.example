# Beta / staging. Copy to deploy/env.beta on the server and fill in.
#
# A different port, a different compose project and therefore a different data
# volume: beta must never read or write production's database.
ENV_NAME=beta
APP_PORT=3131
APP_URL=https://beta.pms.example.com

# Deliberately NOT the production key — a leak from staging must not decrypt
# production credentials.
APP_SECRET_KEY=

# ── Postgres ────────────────────────────────────────────────────────────────
# Left empty and unused while this environment runs on SQLite, which is the
# default. `deploy/to-postgres.sh beta` fills DB_DRIVER and DATABASE_URL in
# once the data has been moved and row-level security has been proved.
#
# DB_DRIVER is what actually chooses the engine. DATABASE_URL on its own does
# nothing — two variables on purpose, because this file used to carry a
# DATABASE_URL left by a scaffold that pointed at a server which did not exist.
DB_DRIVER=
DATABASE_URL=

# The superuser owns the tables; the application connects as PG_APP_USER, which
# owns nothing. FORCE ROW LEVEL SECURITY in the schema covers the owner too, but
# relying on that alone means one table added later without FORCE is a silent
# read across every tenant.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
PG_SUPERUSER=alisio_admin
PG_SUPERUSER_PASSWORD=
PG_APP_USER=alisio_app
PG_APP_PASSWORD=
PG_DATABASE=alisio
# Loopback only, and a different port per environment so the two never meet.
PG_PORT=54331
