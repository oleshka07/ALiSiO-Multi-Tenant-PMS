# Production. Copy to deploy/env.prod on the server and fill in.
# deploy/env.* is gitignored — real secrets never live in the repository.
ENV_NAME=prod
APP_PORT=3130
APP_URL=https://pms.example.com

# 64 hex chars. Encrypts integration credentials (Telegram token, IMAP
# passwords) stored in the database. Losing it makes them unreadable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET_KEY=

# Empty while the application still runs on SQLite (see the data volume).
DATABASE_URL=
