# ALiSiO Multi-Tenant PMS - Centralized Environment Configuration

# 1. Database Connection (PostgreSQL Cloud / Supabase / Hetzner)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alisio_pms?sslmode=disable"

# 2. System URLs & Domains
NEXT_PUBLIC_APP_URL="https://alisio.rozum.one"
NEXT_PUBLIC_APP_DOMAIN="alisio.rozum.one"

# 3. AI Integrations (OpenAI)
OPENAI_API_KEY="sk-proj-..."

# 4. Telegram Bot Notifications
TELEGRAM_BOT_TOKEN="123456789:ABC..."

# 5. Channel Manager & OTA Integrations (Hostex)
HOSTEX_API_KEY="hostex_live_..."

# 6. Payment Gateways (Stripe / GoPay)
STRIPE_SECRET_KEY="sk_test_..."
GOPAY_API_KEY="gopay_..."

# ─── Core ────────────────────────────────────────────────────────────────────
# Public origin of this deployment. Used for guest links, invoices and Telegram
# deep links. Without it those links are relative — never a foreign domain.
APP_URL=

# Encryption key for integration credentials stored in the database (Telegram
# bot token, IMAP passwords, channel API keys). 64 hex chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET_KEY=
