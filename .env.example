# ALiSiO Multi-Tenant PMS - Centralized Environment Configuration

# 1. Database Connection (PostgreSQL Cloud / Supabase / Hetzner)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alisio_pms?sslmode=disable"

# 2. System URLs & Domains
NEXT_PUBLIC_APP_URL="https://pms.example.com"
NEXT_PUBLIC_APP_DOMAIN="pms.example.com"

# 3. AI Integrations (OpenAI)
OPENAI_API_KEY="sk-proj-..."

# 5. Channel Manager & OTA Integrations (Hostex)
HOSTEX_API_KEY="hostex_live_..."

# 6. Payment Gateways (Stripe / GoPay)
STRIPE_SECRET_KEY="sk_test_..."
GOPAY_API_KEY="gopay_..."

# ─── Core ────────────────────────────────────────────────────────────────────
# Public origin of this deployment. Used for guest links and invoice links.
# Without it those links are relative — never a foreign domain.
APP_URL=

# Encryption key for integration credentials stored in the database (IMAP
# passwords, channel API keys). 64 hex chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET_KEY=
